# Copy to .env and fill in. See the README for how to get each value.

# Required. From your Simkl app at https://simkl.com/settings/developer/new/
# Register an "app", not a "website".
SIMKL_CLIENT_ID=

# Required. Generate with: node get-simkl-token.js
SIMKL_ACCESS_TOKEN=

# Optional. Better posters. https://www.themoviedb.org/settings/api
# Falls back to Simkl's own artwork when empty.
TMDB_API_KEY=

# Optional. Origin of the site calling this API, for CORS.
# http://localhost:3000 is always allowed as well.
FRONTEND_URL=http://localhost:3000

PORT=3001
NODE_ENV=development
